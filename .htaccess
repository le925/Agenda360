# ==============================================================================
# Configuración Apache para Agenda360 (Compatible con InfinityFree y XAMPP)
# NOTA: En InfinityFree NO se permite la directiva "Options -Indexes", causaría 403.
# ==============================================================================

DirectoryIndex index.php

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Proteger carpetas ocultas
    RewriteRule ^\.git - [F,L]
</IfModule>
