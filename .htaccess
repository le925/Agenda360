# ==============================================================================
# Configuración Apache para Agenda360 (Compatible con InfinityFree y XAMPP)
# ==============================================================================

# 1. Establecer página de inicio por defecto
DirectoryIndex index.php

# 2. Configuración de codificación predeterminada en UTF-8
AddDefaultCharset UTF-8

# 3. Ocultar listado de directorios por seguridad
Options -Indexes

# 4. Proteger archivos sensibles de ser leídos directamente desde el navegador
<FilesMatch "\.(sql|log|ini|env|example\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 5. Evitar acceso a carpetas ocultas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
</IfModule>
